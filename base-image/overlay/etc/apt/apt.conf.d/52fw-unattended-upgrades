// Fracktal Works: conservative unattended-upgrades policy.
// Only Debian *security* updates; the Raspberry Pi repo (kernel, firmware) is NOT listed,
// so kernel/firmware changes only happen through a tested image release.
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Package-Blacklist {
        "linux-image-.*";
        "linux-headers-.*";
        "raspi-firmware";
        "rpi-eeprom";
        "rpi-swap";
        "octoprint.*";
        "klipper.*";
};
// A printer must never reboot on its own; fw-health/ControlCenter shows "reboot required".
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Keep-Debs-After-Install "false";
Dpkg::Options { "--force-confold"; "--force-confdef"; };
