[Unit]
Description=Fracktal touchscreen UI (X server + ControlCenter) on tty1
After=systemd-user-sessions.service plymouth-quit.service plymouth-quit-wait.service octoprint.service getty@tty1.service
Wants=octoprint.service
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Environment=HOME=/home/pi
# startx with an absolute client script runs THAT instead of the system xinitrc,
# so ControlCenter's own rewrite of /etc/X11/xinit/xinitrc is not needed (see /etc/fw/touchui-managed).
ExecStart=/usr/bin/startx /home/pi/.xinitrc -- :0 vt1 -nocursor -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
